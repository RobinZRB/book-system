{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "booksys/learning-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "kind", "aggregate_id", "occurred_at", "idempotency_key", "payload"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 9},
    "kind": {"enum": ["reading", "review"]},
    "aggregate_id": {"type": "string", "minLength": 9},
    "occurred_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "payload": {"type": "object"}
  }
}
